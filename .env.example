# Copy this file to .env and fill in your own values. .env is gitignored —
# it will never be committed. Never paste real key values into chat.

# Required
OPENAI_API_KEY=

# Optional: only set these if you're using an OpenAI-protocol-compatible
# third-party provider (DeepSeek, Zhipu GLM, Kimi, 通义千问 compatible-mode,
# etc.) instead of the official OpenAI endpoint.
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_VERIFY_MODEL=glm-4-flash
